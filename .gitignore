# TPMS workspace: keep source, configs, docs, and compact result summaries;
# ignore large or regenerable artifacts.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Trained model weights
*.pth
*.pt
*.ckpt

# Packed datasets and scalers
*.npz
*.joblib
*.pkl

# Simulation outputs and logs
**/raw_curves/
**/raw_curves_*/
*.log
*.err.log
**/logs/

# Scratch and generated workspace state
tmp/
tmp_artifacts/
.workspace_cache/
.worktrees/
**/.qoder/repowiki/
start_process_probe.txt

# External third-party material
external/

# IDE / OS
.idea/
.vscode/
.cursor/
Thumbs.db
.DS_Store
